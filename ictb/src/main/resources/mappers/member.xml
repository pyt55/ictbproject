<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.ictb.ictb.dao.MemberDAO">

<insert id="insertMember" parameterType="mem">
insert into member VALUES(member_num_seq.Nextval, #{mname},#{mid},#{password},#{email},sysdate)
</insert>

<select id="countByEmail" parameterType="string" resultType="int">
select count(*) cnt from member where email = #{email}
</select>

<select id="checkId" parameterType="string" resultType="int">
select count(*) cnt from member where mid = #{mid}
</select>

</mapper>




